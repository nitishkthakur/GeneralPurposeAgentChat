# API Keys for LLM providers
# Set one of these depending on which model you want to use

# For OpenAI models (default: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# For Anthropic models (claude-3-5-sonnet, etc.)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration
# Format: provider:model_name
# Examples: openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-20241022
MODEL_NAME=openai:gpt-4o-mini
